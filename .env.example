# ShopSell — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit your real .env
# (it is already listed in .gitignore). On Railway, set these in the service's
# Variables tab instead of shipping a .env file.

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Your exact deployed origin (swap if you redeploy under a different domain).
ALLOWED_ORIGIN=https://shopsell-production.up.railway.app

# ── Database (PostgreSQL) ────────────────────────────────────
# On Railway, reference the Postgres plugin: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally, point at your own Postgres instance.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Secrets — generate each ONCE, then never change them ──────
# JWT_SECRET:     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Exactly 64 hex chars. Encrypts sellers' stored carrier/Stripe credentials.
# Rotating it after data exists makes that data permanently unrecoverable.
ENCRYPTION_KEY=

# ── Stripe (PLATFORM account — charges sellers their monthly fee) ──
# Buyer-payment keys are per-seller "bring your own account" and are set in the
# seller dashboard, NOT here. There is no global publishable key env var.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# ── Email (optional — transactional order/shipping notifications) ──
# If unset, the app simply skips sending email.
RESEND_API_KEY=re_...
RESEND_FROM=orders@yourdomain.com

# ── Carrier sandbox toggles (optional — default to live when unset) ──
UPS_SANDBOX=false
FEDEX_SANDBOX=false

# ── Shopify public app (multi-channel order import via OAuth) ──
# Create a public app in the Shopify Partner Dashboard. These are YOUR single
# set of app credentials (not per-seller). Set the app's allowed redirect URL to
#   <ALLOWED_ORIGIN>/api/channels/shopify/callback
# Scopes: read_orders, write_merchant_managed_fulfillment_orders.
# Leaving these unset disables the Shopify "Connect" button.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ── eBay app (multi-channel order import via OAuth) ──
# Create an app + production keyset in the eBay Developer Program. These are YOUR
# single set of app credentials (not per-seller):
#   EBAY_API_KEY    = App ID  (client_id)
#   EBAY_API_SECRET = Cert ID (client_secret)
#   EBAY_RU_NAME    = the RuName (used as redirect_uri in the OAuth flow)
# Register this URL as the RuName's accepted redirect ("Your auth accepted URL"):
#   <ALLOWED_ORIGIN>/api/channels/ebay/callback
# Scopes: sell.fulfillment, sell.fulfillment.readonly, commerce.identity.readonly.
# Leaving these unset disables the eBay "Connect" button.
EBAY_API_KEY=
EBAY_API_SECRET=
EBAY_RU_NAME=
# Marketplace Account Deletion notification (required for production Sell API
# access, unless you're granted an exemption). Register this endpoint in the
# eBay portal alongside a 32–80 char token [A-Za-z0-9_-] that you set here:
#   Endpoint: <ALLOWED_ORIGIN>/api/webhooks/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=

# ── Etsy app (multi-channel order import via OAuth + PKCE) ──
# Create an app in the Etsy Developer portal. Etsy uses PKCE (no client secret).
# ETSY_KEYSTRING = the app's API Key ("keystring"), which is BOTH the OAuth
# client_id and the required x-api-key header on every request.
# Register this callback URL in the app settings:
#   <ALLOWED_ORIGIN>/api/channels/etsy/callback
# Scopes: transactions_r, transactions_w.
# Leaving this unset disables the Etsy "Connect" button.
ETSY_KEYSTRING=
